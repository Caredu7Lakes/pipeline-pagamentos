{
  "//": "Conector gerenciado Debezium Postgres CDC Source (Confluent Cloud).",
  "//_segredos": "Os valores __preencher__ vêm do .env. NUNCA comite senhas aqui.",

  
  "name": "postgres-cdc-pagamentos",
  "config": {
    "connector.class": "PostgresCdcSourceV2",

    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "__WRITER_API_KEY__",
    "kafka.api.secret": "__WRITER_API_SECRET__",

    "database.hostname": "__POSTGRES_HOST__",
    "database.port": "5432",
    "database.user": "cdc_user",
    "database.password": "__POSTGRES_CDC_PASSWORD__",
    "database.dbname": "neondb",
    "database.sslmode": "require",

    "topic.prefix": "pg",

    "plugin.name": "pgoutput",
    "publication.name": "dbz_pub",
    "slot.name": "dbz_slot_pagamentos",

    "table.include.list": "public.transacoes,public.contas",

    "output.data.format": "AVRO",
    "output.key.format": "AVRO",

    "snapshot.mode": "initial",

    "tasks.max": "1"
  }
}