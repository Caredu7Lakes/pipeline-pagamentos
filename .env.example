# ==========================================================================
# MODELO de variáveis de ambiente. Copie para .env e preencha com valores reais.
#   cp .env.example .env
# O .env NÃO deve ser versionado (está no .gitignore). Aqui ficam só placeholders.
# ==========================================================================

# --- Confluent Cloud: cluster e identidades ---
CONFLUENT_ENVIRONMENT_ID=env-xxxxx
CONFLUENT_CLUSTER_ID=lkc-xxxxx
CONFLUENT_BOOTSTRAP_SERVER=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092

# Identidade de ESCRITA (conector CDC)
WRITER_API_KEY=__preencher__
WRITER_API_SECRET=__preencher__

# Identidade de LEITURA (Flink / consumidores)
READER_API_KEY=__preencher__
READER_API_SECRET=__preencher__

# --- Schema Registry ---
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-2.aws.confluent.cloud
SCHEMA_REGISTRY_API_KEY=__preencher__
SCHEMA_REGISTRY_API_SECRET=__preencher__

# --- Postgres (origem do CDC) ---
POSTGRES_HOST=__preencher__
POSTGRES_PORT=5432
POSTGRES_DB=pagamentos
POSTGRES_CDC_USER=cdc_user
POSTGRES_CDC_PASSWORD=__preencher__
POSTGRES_PUBLICATION=dbz_pub

# --- Flink (Confluent Cloud) ---
FLINK_COMPUTE_POOL_ID=lfcp-xxxxx

# --- Ramos de IA (opcionais; só se for acoplar scoring/RAG) ---
# VECTOR_DB_URL=__preencher__
# VECTOR_DB_API_KEY=__preencher__
# EMBEDDING_MODEL=__preencher__

# --- Banco de dados de destino (Neon) ---

DATABASE_URL=postgresql://USUARIO:SENHA@HOST.us-east-2.aws.neon.tech/DBNAME?sslmode=require